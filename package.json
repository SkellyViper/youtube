{
  "name": "explainer-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Frame-driven animation engine for AI explainer videos: one React source of truth for live keyboard-driven presentation (Remotion Player) and deterministic MP4 export (Remotion renderer).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "present": "vite build && vite preview --open",
    "studio": "remotion studio",
    "render": "node scripts/render.mjs NotDetected out/demo.mp4",
    "render:intro": "node scripts/render.mjs RogueAgent out/rogue-agent-intro.mp4",
    "render:30": "node scripts/render.mjs NotDetected30 out/demo-30fps.mp4",
    "stills": "node scripts/stills.mjs NotDetected",
    "verify:video": "node scripts/verify-video.mjs out/demo.mp4",
    "typecheck": "tsc --noEmit",
    "test": "playwright test",
    "build": "vite build",
    "perf": "node scripts/perf.mjs",
    "lab:render": "node scripts/lab.mjs render",
    "lab:stills": "node scripts/lab.mjs stills",
    "lab:thumbs": "node scripts/lab.mjs thumbs",
    "lab:frames": "node scripts/lab.mjs frames",
    "lab:sheet": "node scripts/lab.mjs sheet",
    "lab:check": "node scripts/lab.mjs check",
    "lab:compare": "node scripts/lab.mjs compare"
  },
  "dependencies": {
    "@remotion/cli": "4.0.540",
    "@remotion/fonts": "4.0.540",
    "@remotion/media": "4.0.540",
    "@remotion/player": "4.0.540",
    "@remotion/three": "4.0.540",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.540"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "@playwright/test": "1.64.1",
    "@remotion/bundler": "4.0.540",
    "@remotion/renderer": "4.0.540",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.187.0",
    "@vitejs/plugin-react": "6.2.1",
    "typescript": "^5.9.0",
    "vite": "8.3.5"
  }
}
